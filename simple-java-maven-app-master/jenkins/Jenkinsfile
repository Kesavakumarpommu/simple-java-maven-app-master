pipeline {
    agent any
    
    // Environment variables used throughout the pipeline
    environment {
        // Absolute path to the JDK 21 installation on this Windows machine
        JAVA_HOME = 'C:\\Program Files\\Eclipse Adoptium\\jdk-21.0.12.101-hotspot'
        
        // Adds Java compiler and tools to the execution PATH
        PATH = "${JAVA_HOME}\\bin;${env.PATH}"
    }
    
    // Pipeline settings
    options {
        // Skip subsequent stages if any previous stage fails
        skipStagesAfterUnstable()
    }
    
    stages {
        // =========================================================
        // STAGE 1: CHECKOUT
        // Clones the application source code from GitHub
        // =========================================================
        stage('Checkout') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/skillupwithsachin/simple-java-maven-app.git'
            }
        }
        
        // =========================================================
        // STAGE 2: BUILD
        // Compiles code and packages it into a JAR file
        // =========================================================
        stage('Build') {
            steps {
                bat 'mvn -B -DskipTests clean package'
            }
        }
        
        // =========================================================
        // STAGE 3: TEST
        // Executes automated unit tests and records results
        // =========================================================
        stage('Test') {
            steps {
                bat 'mvn test'
            }
            post {
                always {
                    // Publishes test report graphs on Jenkins
                    junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
                }
            }
        }

        // =========================================================
        // STAGE 4: SONARQUBE ANALYSIS (OPTIONAL / COMMENTED)
        // Purpose: Static Code Analysis & Vulnerability Scanning
        // =========================================================
        // stage('SonarQube Analysis') {
        //     steps {
        //         withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
        //             bat "mvn sonar:sonar -Dsonar.projectKey=simple-java-maven-app -Dsonar.host.url=http://localhost:9000 -Dsonar.login=%SONAR_TOKEN%"
        //         }
        //     }
        // }

        // =========================================================
        // STAGE 5: UPLOAD TO NEXUS (OPTIONAL / COMMENTED)
        // Purpose: Artifact Repository Management
        // =========================================================
        // stage('Upload to Nexus') {
        //     steps {
        //         bat 'mvn deploy -DskipTests -s settings.xml -DaltDeploymentRepository=nexus::default::http://localhost:8081/repository/maven-snapshots/'
        //     }
        // }
        
        // =========================================================
        // STAGE 6: DELIVER
        // Verifies the build by running the packaged JAR application
        // =========================================================
        stage('Deliver') { 
            steps {
                bat 'java -jar target\\my-app-1.0-SNAPSHOT.jar'
            }
        }
    }
}
