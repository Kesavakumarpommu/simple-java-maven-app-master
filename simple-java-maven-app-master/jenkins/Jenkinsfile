pipeline {
    agent any
    
    environment {
        // Updated to typical Windows installation paths. Adjust if your Java/Maven paths are different.
        JAVA_HOME = 'C:\\Program Files\\Java\\jdk-21' 
        MAVEN_HOME = 'C:\\Program Files\\Maven'
        
        // Appending Maven and Java to the Windows system Path
        PATH = "${MAVEN_HOME}\\bin;${JAVA_HOME}\\bin;${env.PATH}"
        
        // Nexus Configuration
        NEXUS_URL = "http://52.90.103.249:8081"
        NEXUS_CREDENTIAL_ID = "nexus-credentials"
        SONARQUBE_URL = "http://52.90.103.249:9000"
    }
    
    options {
        skipStagesAfterUnstable()
    }
    
    stages {
        stage('Checkout') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/skillupwithsachin/simple-java-maven-app.git'
            }
        }
        
        stage('Build') {
            steps {
                bat 'mvn -B -DskipTests clean package'
            }
        }
        
        stage('Test') {
            steps {
                bat 'mvn test'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
                    bat """
                        mvn sonar:sonar ^
                        -Dsonar.projectKey=simple-java-maven-app ^
                        -Dsonar.projectName="Simple Java Maven App" ^
                        -Dsonar.host.url=${SONARQUBE_URL} ^
                        -Dsonar.token=${SONAR_TOKEN}
                    """
                }
            }
        }
        
        stage('Upload to Nexus') {
            steps {
                // Using PowerShell to safely create the settings.xml file on Windows
                powershell '''
                    $xml = @"
<?xml version="1.0" encoding="UTF-8"?>
<settings>
  <servers>
    <server>
      <id>nexus</id>
      <username>admin</username>
      <password>admin</password>
    </server>
  </servers>
</settings>
"@
                    Set-Content -Path settings.xml -Value $xml
                '''
                
                // Deploying to Nexus via Windows batch
                bat 'mvn deploy -DskipTests -s settings.xml -DaltDeploymentRepository=nexus::http://52.90.103.249:8081/repository/maven-snapshots/'
            }
        }
        
        stage('Deliver') { 
            steps {
                // Running the delivery script via Windows batch
                bat 'cmd /c jenkins\\scripts\\deliver.bat' 
            }
        }
    }
}
